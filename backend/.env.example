# Configuración del Servidor
PORT=3000
SESSION_SECRET=tu_secreto_de_sesion_aqui

# Credenciales OAuth (Necesitas crear apps en cada plataforma)
# YouTube (Google Cloud Console)
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/youtube/callback

# Facebook (Meta for Developers)
FACEBOOK_APP_ID=tu_facebook_app_id_aqui
FACEBOOK_APP_SECRET=tu_facebook_app_secret_aqui
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

# Twitch (Twitch Developers)
TWITCH_CLIENT_ID=tu_twitch_client_id_aqui
TWITCH_CLIENT_SECRET=tu_twitch_client_secret_aqui
TWITCH_CALLBACK_URL=http://localhost:3000/auth/twitch/callback

# Stream Keys de las Plataformas (Opcional - si prefieres RTMP directo)
YOUTUBE_STREAM_KEY=tu_youtube_stream_key_aqui
FACEBOOK_STREAM_KEY=tu_facebook_stream_key_aqui
TWITCH_STREAM_KEY=tu_twitch_stream_key_aqui
INSTAGRAM_STREAM_KEY=tu_instagram_stream_key_aqui
TIKTOK_STREAM_KEY=tu_tiktok_stream_key_aqui
TWITTER_STREAM_KEY=tu_twitter_stream_key_aqui

# URLs RTMP (generalmente no cambian)
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
FACEBOOK_RTMP_URL=rtmps://live-api-s.facebook.com:443/rtmp
TWITCH_RTMP_URL=rtmp://live.twitch.tv/app
INSTAGRAM_RTMP_URL=rtmps://live-upload.instagram.com:443/rtmp
TIKTOK_RTMP_URL=rtmp://tiktok.com/live
TWITTER_RTMP_URL=rtmps://live.twitter.com/rtmp
